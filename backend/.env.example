# StructGuru backend — example environment file.
# Copy to `.env` and fill in real values for local development.

# MongoDB connection string
MONGODB_URI=

# JWT signing secret (any long random string)
JWT_SECRET=

# SMTP credentials for OTP emails (signup/login)
EMAIL_USER=
EMAIL_PASS=

# HTTP port (default 3001)
PORT=3001

# ── AI Chatbot ────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
# Leave GROQ_API_KEY blank to disable the /api/chat endpoint (returns 503).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile